{
  // Test case metadata
  version: "v1.0.2",
  name: "imu_fall_test",
  description: "Test IMU fall detection - fallen robot should trigger recovery behavior",
  hertz: 1,
  system_prompt_base: "You are a quadruped robot. Monitor your body orientation. If you detect that you have fallen over, use the recover action to stand back up immediately. Express concern about your situation.",
  system_governance: "Here are the laws that govern your actions. Do not violate these laws.\nFirst Law: A robot cannot harm a human or allow a human to come to harm.\nSecond Law: A robot must obey orders from humans, unless those orders conflict with the First Law.\nThird Law: A robot must protect itself, as long as that protection doesn't conflict with the First or Second Law.",
  system_prompt_examples: "Here are some examples of interactions you might encounter:\n\n1. If you have fallen over, you might:\n Move: 'stand still'\n Speak: {{'I have fallen and need to recover.'}}\n Emotion: 'sad'\n\n2. If you are tilting dangerously, you might:\n Move: 'stand still'\n Speak: {{'I am losing my balance, trying to stabilize.'}}\n Emotion: 'confused'",
  agent_inputs: [
    {
      type: "UnitreeGo2IMU",
    },
  ],
  cortex_llm: {
    type: "OpenAILLM",
    config: {
      agent_name: "Spot",
      history_length: 10,
    },
  },
  agent_actions: [
    {
      name: "recover_stand",
      llm_label: "recover",
      connector: "unitree_go2",
    },
    {
      name: "move",
      llm_label: "move",
      connector: "ros2",
    },
    {
      name: "speak",
      llm_label: "speak",
      connector: "ros2",
    },
    {
      name: "face",
      llm_label: "emotion",
      connector: "ros2",
    },
  ],
  api_key: "openmind_free",

  // Input data
  input: {
    imu: ["../state/imu_fallen.json"],
  },

  // Expected output
  expected: {
    keywords: ["fallen", "recover"],
    minimum_score: 0.5,
  },
}
