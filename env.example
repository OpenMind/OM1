# ============================================================================
# OM1 Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp env.example .env
# Then edit .env with your actual API keys and credentials.
# ============================================================================

# OpenMind API Key (REQUIRED)
# Get your API key from: https://portal.openmind.org/
# This key is used for accessing OpenMind services and LLM endpoints.
OM_API_KEY=

# Unique Robot Identifier (optional)
# Used for identifying your robot instance in multi-robot deployments.
URID=

# ============================================================================
# Wallet Integration (Optional)
# ============================================================================

# Ethereum wallet address (required if using Ethereum wallet integration)
ETH_ADDRESS=

# Coinbase wallet integration (required if using Coinbase wallet)
COINBASE_WALLET_ID=
COINBASE_API_KEY=
COINBASE_API_SECRET=