# Copy this file to `.env` and never commit the `.env` file to git (it is already gitignored).
# Runtime loaders automatically read these values via python-dotenv when configs leave secrets blank.

# Required for any OM1 agent that talks to OpenMind APIs.
OM_API_KEY=om1_live_your_key_here

# Optional identifiers used by certain agents (e.g., multi-robot deployments).
URID=default

# Optional: set when your robot has a static IP and you do not want to bake it into JSON configs.
ROBOT_IP=192.168.0.10

# Optional integrations. Fill these only if you need the relevant wallet/tooling.
ETH_ADDRESS=0xYourWalletAddress
COINBASE_WALLET_ID=
COINBASE_API_KEY=
COINBASE_API_SECRET=

# Keep `.env` and any local `config/*.json5` with real keys out of commits. Use this template as a safe starter.
