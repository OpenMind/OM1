{
  version: "v1.1.0",
  name: "memory recall basic",
  description: "memory test",
  hertz: 50,
  wait_for_calls: 2,
  timeout_ms: 8000,

  system_prompt_base: "You are a friendly robot with memory.",

  memory: {
    enabled: true,
    cloud_connection: false,
  },

  agent_inputs: [
    {
      type: "mock_input",
      config: {
        messages: [
          "I love playing basketball on weekends",
          "Do you remember what sport I like?",
        ],
        voice_key: "Voice",
        triggers_tick: true,
        dynamic_vars: {
          current_user_id: "test_user_001",
          current_user_name: "Alice",
        },
      },
    },
  ],

  cortex_llm: {
    type: "scripted_llm",
    config: {
      rules: [
        {
          // When memory is injected, the prompt contains "MEMORY:"
          when_contains: "MEMORY:",
          tool_calls: [
            { name: "speak", arguments: { sentence: "I remember you like basketball!" } },
          ],
        },
        {
          // Fallback for the first tick (no memory yet)
          when_contains: "",
          tool_calls: [
            { name: "speak", arguments: { sentence: "That sounds fun!" } },
          ],
        },
      ],
    },
  },

  agent_actions: [
    { name: "speak", llm_label: "speak", connector: "recording" },
  ],

  expected: {
    action_calls: [
      { action: "speak", arg_contains: { sentence: "remember" } },
    ],
  },
}
