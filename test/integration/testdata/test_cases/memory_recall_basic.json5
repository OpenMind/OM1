{
  version: "v1.1.0",
  name: "memory recall basic",
  description: "Seeds memory with 2 messages, then queries to verify correct retrieval",
  hertz: 10,
  wait_for_calls: 3,
  timeout_ms: 30000,

  system_prompt_base: "You are a friendly robot with memory.",

  memory: {
    enabled: true,
    cloud_connection: false,
  },

  agent_inputs: [
    {
      type: "mock_input",
      config: {
        messages: [
          "I love playing basketball on weekends",
          "The Lakers are my favorite NBA team",
          "What sport do I play?",
        ],
        voice_key: "Voice",
        triggers_tick: true,
        dynamic_vars: {
          current_user_id: "test_user_001",
          current_user_name: "Alice",
        },
      },
    },
  ],

  cortex_llm: {
    type: "scripted_llm",
    config: {
      rules: [
        { when_contains_all: ["What sport do I play", "basketball"], tool_calls: [{ name: "speak", arguments: { sentence: "recall: basketball" } }] },
        { when_contains: "", tool_calls: [{ name: "speak", arguments: { sentence: "acknowledged" } }] },
      ],
    },
  },

  agent_actions: [
    { name: "speak", llm_label: "speak", connector: "recording" },
  ],

  expected: {
    action_calls: [
      { action: "speak", arg_contains: { sentence: "recall: basketball" } },
    ],
  },
}
