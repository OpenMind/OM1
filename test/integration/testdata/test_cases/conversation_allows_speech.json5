{
  // The same caption plus a conversation-role input: now the speech is allowed, because someone spoke.
  version: "v1.1.0",
  name: "conversation allows speech",
  description: "a voice turn lets the robot answer",
  hertz: 50,
  timeout_ms: 800,
  wait_for_calls: 1,

  system_prompt_base: "You are a test robot.",

  agent_inputs: [
    {
      type: "mock_input",
      config: { text: "camera: a person sitting at a desk", triggers_tick: false, role: "world" },
    },
    {
      type: "mock_input",
      config: { text: "what do you see?", triggers_tick: true, role: "conversation" },
    },
  ],

  cortex_llm: {
    type: "scripted_llm",
    config: {
      rules: [
        {
          when_contains: "what do you see",
          tool_calls: [ { name: "speak", arguments: { sentence: "a person at a desk" } } ],
        },
      ],
    },
  },

  agent_actions: [
    { name: "speak", llm_label: "speak", connector: "recording" },
  ],

  expected: {
    action_calls: [ { action: "speak", arg_contains: { sentence: "a person at a desk" } } ],
  },
}
