{
  // Exercises concurrent multi-action output: a single LLM decision emits two
  // tool calls (move + speak) that must both be dispatched to their connectors.
  version: "v1.1.0",
  name: "stop and warn on obstacle",
  description: "one LLM decision fans out to two concurrent actions",
  hertz: 50,
  wait_for_calls: 2,
  timeout_ms: 3000,

  system_prompt_base: "You are a cautious test robot.",

  agent_inputs: [
    {
      type: "mock_input",
      config: {
        text: "There is an obstacle directly ahead",
        triggers_tick: true,
      },
    },
  ],

  cortex_llm: {
    type: "scripted_llm",
    config: {
      rules: [
        {
          when_contains: "obstacle",
          tool_calls: [
            { name: "move", arguments: { direction: "stop" } },
            { name: "speak", arguments: { sentence: "Stopping for the obstacle" } },
          ],
        },
      ],
    },
  },

  agent_actions: [
    { name: "move", llm_label: "move", connector: "recording" },
    { name: "speak", llm_label: "speak", connector: "recording" },
  ],

  expected: {
    min_calls: 2,
    action_calls: [
      { action: "move", arg_contains: { direction: "stop" } },
      { action: "speak", arg_contains: { sentence: "obstacle" } },
    ],
  },
}
