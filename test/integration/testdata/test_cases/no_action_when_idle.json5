{
  // The input never matches any LLM rule, so the cortex returns no tool calls and
  // no action connector should ever fire. Guards against spurious dispatches.
  name: "no action when idle",
  description: "unmatched input produces no actions",
  hertz: 50,
  timeout_ms: 800,

  system_prompt_base: "You are an idle test robot.",

  agent_inputs: [
    {
      type: "mock_input",
      config: { text: "nothing interesting is happening", triggers_tick: true },
    },
  ],

  cortex_llm: {
    type: "scripted_llm",
    config: {
      rules: [
        {
          when_contains: "emergency",
          tool_calls: [
            { name: "speak", arguments: { sentence: "should never fire" } },
          ],
        },
      ],
    },
  },

  agent_actions: [
    { name: "speak", llm_label: "speak", connector: "recording" },
  ],

  expected: {
    no_calls: true,
  },
}
