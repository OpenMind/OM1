{
  // Global background drives a transition: a top-level global_background (not tied
  // to any mode) publishes a context flag (awake=true) onto the mode-context bus.
  // The runtime re-evaluates and switches idle -> active, which then acts. Proves
  // that global_backgrounds are loaded, started once, and run regardless of mode.
  version: "v1.1.0",
  name: "global background drives a context-aware transition",
  description: "a global_background publishes a flag that transitions the mode and the new mode acts",
  default_mode: "idle",
  wait_for_calls: 1,
  timeout_ms: 5000,

  global_backgrounds: [
    {
      type: "mock_background",
      config: { publish_context: { awake: true } },
    },
  ],

  transition_rules: [
    {
      from_mode: "idle",
      to_mode: "active",
      transition_type: "context_aware",
      context_conditions: { awake: true },
      priority: 1,
    },
  ],

  modes: {
    idle: {
      name: "idle",
      hertz: 50,
      system_prompt_base: "You are idle, waiting for a wake signal.",
      agent_inputs: [
        { type: "mock_input", config: { text: "waiting", triggers_tick: true } },
      ],
      cortex_llm: { type: "scripted_llm", config: { rules: [] } },
      agent_actions: [],
    },

    active: {
      name: "active",
      hertz: 50,
      system_prompt_base: "You are awake and acting.",
      agent_inputs: [
        { type: "mock_input", config: { text: "now awake", triggers_tick: true } },
      ],
      cortex_llm: {
        type: "scripted_llm",
        config: {
          rules: [
            {
              when_contains: "awake",
              tool_calls: [ { name: "speak", arguments: { sentence: "Awake and acting" } } ],
            },
          ],
        },
      },
      agent_actions: [
        { name: "speak", llm_label: "speak", connector: "recording" },
      ],
    },
  },

  expected: {
    action_calls: [
      { action: "speak", arg_contains: { sentence: "Awake and acting" } },
    ],
  },
}
