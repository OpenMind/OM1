{
  // Negative transition test: a person-keyword rule exists, but the patrol input
  // never mentions a person, so the robot stays in patrol and keeps acting there.
  // The greet mode must never run. Mirrors the Python mode_no_transition case.
  version: "v1.1.0",
  name: "no transition when keyword absent",
  description: "input-triggered rule does not fire; original mode keeps acting",
  default_mode: "patrol",
  timeout_ms: 800,

  transition_rules: [
    {
      from_mode: "patrol",
      to_mode: "greet",
      transition_type: "input_triggered",
      trigger_keywords: ["person"],
      priority: 1,
    },
  ],

  modes: {
    patrol: {
      name: "patrol",
      hertz: 50,
      system_prompt_base: "You are on patrol.",
      agent_inputs: [
        { type: "mock_input", config: { text: "the corridor is clear", triggers_tick: true } },
      ],
      cortex_llm: {
        type: "scripted_llm",
        config: {
          rules: [
            {
              when_contains: "clear",
              tool_calls: [ { name: "speak", arguments: { sentence: "Continuing patrol" } } ],
            },
          ],
        },
      },
      agent_actions: [
        { name: "speak", llm_label: "speak", connector: "recording" },
      ],
    },

    greet: {
      name: "greet",
      hertz: 50,
      system_prompt_base: "You are greeting a visitor.",
      agent_inputs: [
        { type: "mock_input", config: { text: "Hello!", triggers_tick: true } },
      ],
      cortex_llm: {
        type: "scripted_llm",
        config: {
          rules: [
            {
              when_contains: "Hello",
              tool_calls: [ { name: "speak", arguments: { sentence: "Welcome, visitor!" } } ],
            },
          ],
        },
      },
      agent_actions: [
        { name: "speak", llm_label: "speak", connector: "recording" },
      ],
    },
  },

  expected: {
    action_calls: [
      { action: "speak", arg_contains: { sentence: "Continuing patrol" } },
    ],
    forbidden_calls: [
      { action: "speak", arg_contains: { sentence: "Welcome" } },
    ],
  },
}
