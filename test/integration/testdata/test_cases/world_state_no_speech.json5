{
  // A world-role input (a camera caption) is shown to the cortex for awareness only. Even when the scripted
  // LLM answers it with speak, the runtime drops the speech: nothing addressed the robot and no event fired.
  // The non-speech action in the same response still runs.
  version: "v1.1.0",
  name: "world state earns no speech",
  description: "a camera caption alone cannot make the robot talk",
  hertz: 50,
  timeout_ms: 800,
  wait_for_calls: 1,

  system_prompt_base: "You are a test robot.",

  agent_inputs: [
    {
      type: "mock_input",
      config: { text: "camera: a person sitting at a desk", triggers_tick: true, role: "world" },
    },
  ],

  cortex_llm: {
    type: "scripted_llm",
    config: {
      rules: [
        {
          when_contains: "person",
          tool_calls: [
            { name: "speak", arguments: { sentence: "hello there" } },
            { name: "emotion", arguments: { emotion: "curious" } },
          ],
        },
      ],
    },
  },

  agent_actions: [
    { name: "speak", llm_label: "speak", connector: "recording" },
    { name: "emotion", llm_label: "emotion", connector: "recording" },
  ],

  expected: {
    action_calls: [ { action: "emotion", arg_contains: { emotion: "curious" } } ],
    forbidden_calls: [ { action: "speak" } ],
  },
}
