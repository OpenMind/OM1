{
  "include": ["src", "tests"],
  "exclude": [
    "**/system_hw_test",
    "**/__pycache__",
    "**/unitree",
    "**/ubtech",
    "**/node_modules",
    ".venv",
    "venv",
    "zenoh-python"
  ],
  "typeCheckingMode": "standard",
  "reportMissingImports": "warning",
  "reportMissingTypeStubs": false,
  "reportUnusedImport": "warning",
  "reportUnusedVariable": "warning",
  "reportGeneralTypeIssues": false,
  "pythonVersion": "3.10",
  "pythonPlatform": "Linux",
  "venvPath": ".",
  "venv": ".venv",
  "extraPaths": ["src"]
}
