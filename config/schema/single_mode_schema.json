{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
        "version",
        "hertz",
        "name",
        "api_key",
        "system_prompt_base",
        "system_governance",
        "system_prompt_examples",
        "agent_inputs",
        "cortex_llm",
        "agent_actions"
    ],
    "properties": {
        "version": {"type": "string"},
        "hertz": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "The frequency (in Hz) at which the control loop runs. Must be positive."
        },
        "name": {"type": "string"},
        "api_key": {"type": "string"},
        "URID": {"type": "string"},
        "use_sim": {"type": "boolean"},
        "unitree_ethernet": {"type": "string"},
        "system_prompt_base": {"type": "string"},
        "system_governance": {"type": "string"},
        "system_prompt_examples": {"type": "string"},
        "knowledge_base": {
            "type": "object",
            "description": "Optional knowledge base configuration for document retrieval.",
            "properties": {
                "knowledge_base_name": {"type": "string", "description": "Name of the knowledge base directory."},
                "knowledge_base_root": {"type": "string", "description": "Root directory path for knowledge bases."}
            }
        },
        "agent_inputs": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["type"],
                "properties": {
                    "type": {"type": "string"},
                    "config": {"type": "object"}
                }
            }
        },
        "simulators": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["type"],
                "properties": {
                    "type": {"type": "string"},
                    "config": {"type": "object"}
                }
            }
        },
        "cortex_llm": {
            "type": "object",
            "required": ["type"],
            "properties": {
                "type": {"type": "string"},
                "config": {
                    "type": "object",
                    "properties": {
                        "agent_name": {"type": "string"},
                        "history_length": {"type": "integer"}
                    }
                }
            }
        },
        "agent_actions": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["name", "connector"],
                "properties": {
                    "name": {"type": "string"},
                    "llm_label": {"type": "string"},
                    "connector": {"type": "string"},
                    "config": {"type": "object"},
                    "exclude_from_prompt": {
                        "type": "boolean",
                        "default": false
                    }
                }
            }
        },
"thinking_behavior": {
  "type": "object",
  "description": "Configuration for thinking behavior when the robot is processing complex queries",
  "properties": {
    "enabled": { "type": "boolean", "default": false },
    "face_action": { "type": "string", "default": "think" },
    "move_action": { "type": "string", "default": "stand still" },
    "trigger_delay": { "type": "number", "default": 1.0, "minimum": 0.1 },
    "min_duration": { "type": "number", "default": 1.0, "minimum": 0.1 },
    "max_duration": { "type": "number", "default": 3.0, "minimum": 0.5 }
  },
  "required": ["enabled"],
  "additionalProperties": false
}
        "backgrounds": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["type"],
                "properties": {
                    "type": {"type": "string"},
                    "config": {"type": "object"}
                }
            }
        },
        "action_execution_mode": {
            "type": "string",
            "enum": ["concurrent", "sequential", "dependencies"]
        },
        "action_dependencies": {
            "type": "object",
            "additionalProperties": {
                "type": "array",
                "items": {"type": "string"}
            }
        }
    },
    "additionalProperties": true
}
