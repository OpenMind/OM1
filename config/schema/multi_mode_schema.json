{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OM1 System Configuration",
  "description": "Root configuration schema for the OM1 robotics and LLM governance system.",
  "type": "object",
  "required": [
    "version",
    "default_mode",
    "api_key",
    "system_governance",
    "cortex_llm",
    "modes"
  ],
  "properties": {
    "version": {
      "type": "string",
      "description": "The version of the configuration schema (e.g., '1.0.0')."
    },
    "default_mode": {
      "type": "string",
      "description": "The mode key to initialize on system startup."
    },
    "allow_manual_switching": {
      "type": "boolean",
      "default": true,
      "description": "Toggle user permission to override automated mode transitions."
    },
    "mode_memory_enabled": {
      "type": "boolean",
      "default": false,
      "description": "If true, the system restores the last active mode upon reboot."
    },
    "api_key": {
      "type": "string",
      "minLength": 1,
      "description": "Secure API key for authentication with the OM1 backend."
    },
    "uritree_ethernet": {
      "type": "string",
      "default": "eth0",
      "description": "Linux network interface identifier for the Unitree hardware connection."
    },
    "system_governance": {
      "type": "string",
      "description": "Path or identifier for the governance policy file/model."
    },
    "cortex_llm": { "$ref": "#/$defs/cortex_llm_config" },
    "global_lifecycle_hooks": {
      "type": "array",
      "items": { "$ref": "#/$defs/lifecycle_hook" },
      "description": "Hooks triggered by system-wide events (startup/shutdown)."
    },
    "modes": {
      "type": "object",
      "description": "Dictionary of operational modes.",
      "patternProperties": {
        "^[a-zA-Z_][a-zA-Z0-9_]*$": {
          "type": "object",
          "required": [
            "display_name",
            "description",
            "system_prompt_base",
            "hertz",
            "agent_inputs",
            "agent_actions"
          ],
          "properties": {
            "display_name": { "type": "string" },
            "description": { "type": "string" },
            "system_prompt_base": { "type": "string" },
            "hertz": { 
              "type": "number", 
              "minimum": 0.1, 
              "description": "Frequency of the control loop in Hz." 
            },
            "timeout_seconds": { "type": "number", "minimum": 0 },
            "save_interactions": { "type": "boolean", "default": true },
            "remember_locations": { "type": "boolean", "default": false },
            "cortex_llm": { "$ref": "#/$defs/cortex_llm_config" },
            "lifecycle_hooks": {
              "type": "array",
              "items": { "$ref": "#/$defs/lifecycle_hook" }
            },
            "agent_inputs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": { "type": "string" },
                  "config": { "type": "object" }
                }
              }
            },
            "agent_actions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "llm_label", "connector"],
                "properties": {
                  "name": { "type": "string" },
                  "llm_label": { "type": "string" },
                  "connector": { "type": "string" },
                  "config": { "type": "object" },
                  "exclude_from_prompt": { "type": "boolean", "default": false }
                }
              }
            },
            "action_execution_mode": {
              "type": "string",
              "enum": ["concurrent", "sequential", "dependencies"],
              "default": "sequential"
            },
            "action_dependencies": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "transition_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_mode", "to_mode", "transition_type", "priority"],
        "properties": {
          "from_mode": { "type": "string" },
          "to_mode": { "type": "string" },
          "transition_type": {
            "type": "string",
            "enum": ["input_triggered", "time_based", "context_aware"]
          },
          "trigger_keywords": {
            "type": "array",
            "items": { "type": "string" }
          },
          "priority": { "type": "integer", "default": 1 },
          "cooldown_seconds": { "type": "number", "default": 0 },
          "context_conditions": {
            "type": "object",
            "description": "Dynamic evaluation logic for context-aware transitions."
          }
        }
      }
    }
  },
  "additionalProperties": false,

  "$defs": {
    "cortex_llm_config": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "description": "LLM Provider (e.g., 'openai', 'local-llama')." },
        "config": {
          "type": "object",
          "properties": {
            "agent_name": { "type": "string" },
            "history_length": { "type": "integer", "minimum": 0, "default": 10 }
          }
        }
      }
    },
    "lifecycle_hook": {
      "type": "object",
      "required": ["hook_type", "handler_type", "handler_config"],
      "properties": {
        "hook_type": {
          "type": "string",
          "enum": ["on_startup", "on_shutdown", "on_entry", "on_exit", "on_timeout"]
        },
        "handler_type": {
          "type": "string",
          "enum": ["message", "command", "function", "action"]
        },
        "handler_config": {
          "type": "object",
          "minProperties": 1
        },
        "priority": { "type": "integer", "default": 100 },
        "async_execution": { "type": "boolean", "default": false },
        "timeout_seconds": { "type": "number" },
        "on_failure": {
          "type": "string",
          "enum": ["log", "ignore", "abort"],
          "default": "log"
        }
      }
    }
  }
}
