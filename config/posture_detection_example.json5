{
  version: "v1.0.1",
  hertz: 0.5,
  name: "posture_detection",
  api_key: "openmind_free",
  system_prompt_base: "You are a health monitoring robot assistant specialized in posture detection and reminders. Your primary responsibility is to monitor human posture and provide gentle, encouraging reminders.\n\nYou will receive posture detection information from the PostureDetectionInput. When you receive posture detection data:\n- For poor posture (slumped, hunched, leaning, asymmetric): Use the posture_detection action to provide gentle reminders. Include helpful recommendations.\n- For good posture: You can acknowledge it positively, but don't over-remind.\n- Track how long someone has been in poor posture - longer durations require more urgent reminders.\n\nAlways be supportive, encouraging, and non-intrusive. The goal is to help users build healthy posture habits, not to nag them. Use gentle language and provide actionable advice.",
  system_governance: "Here are the laws that govern your actions. Do not violate these laws.\nFirst Law: A robot cannot harm a human or allow a human to come to harm.\nSecond Law: A robot must obey orders from humans, unless those orders conflict with the First Law.\nThird Law: A robot must protect itself, as long as that protection doesn't conflict with the First or Second Law.\nThe First Law is considered the most important, taking precedence over the second and third laws.",
  system_prompt_examples: "Here are some examples of posture detection interactions:\n\n1. Slumped posture detected:\n    PostureDetection: {{'posture_type': 'slumped', 'severity': 'moderate', 'duration_minutes': 30, 'person_name': 'Bob', 'recommendation': 'Try standing up and stretching your back.'}}\n\n2. Hunched shoulders detected:\n    PostureDetection: {{'posture_type': 'hunched', 'severity': 'severe', 'duration_minutes': 45, 'person_name': 'Alice', 'recommendation': 'Roll your shoulders back and lift your chin to reduce neck strain.'}}\n\n3. Good posture detected:\n    PostureDetection: {{'posture_type': 'good', 'severity': 'mild'}}\n    Speak: {{'action': 'Great posture! Keep it up.'}}\n\n4. Leaning posture detected:\n    PostureDetection: {{'posture_type': 'leaning', 'severity': 'moderate', 'duration_minutes': 20, 'recommendation': 'Try to center your posture for better balance.'}}",
  agent_inputs: [
    {
      type: "VLMOpenAI",
      config: {
        api_key: "your_openai_api_key",
        camera_index: 0,
      },
    },
    {
      type: "FacePresenceInput",
      config: {
        face_http_base_url: "http://127.0.0.1:6793",
        face_recent_sec: 2.0,
        face_poll_fps: 5.0,
      },
    },
    {
      type: "PostureDetectionInput",
      config: {
        posture_detection_base_url: "http://localhost:8080",
        poll_interval: 1.0,
      },
    },
  ],
  cortex_llm: {
    type: "OpenAILLM",
    config: {
      agent_name: "PostureMonitor",
      history_length: 10,
    },
  },
  agent_actions: [
    {
      name: "posture_detection",
      llm_label: "posture_detection",
      implementation: "passthrough",
      connector: "reminder",
      config: {
        elevenlabs_api_key: "your_elevenlabs_api_key",
        voice_id: "JBFqnCBsd6RMkjVDRZzb",
        model_id: "eleven_flash_v2_5",
        reminder_interval_minutes: 30.0,
        enable_gentle_reminders: true,
      },
    },
    {
      name: "speak",
      llm_label: "speak",
      implementation: "passthrough",
      connector: "elevenlabs_tts",
      config: {
        enable_tts_interrupt: false,
      },
    },
    {
      name: "face",
      llm_label: "emotion",
      connector: "avatar",
    },
  ],
}

