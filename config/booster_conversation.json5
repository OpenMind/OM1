{
  version: "v1.0.5",
  hertz: 0.01,
  name: "conversation",
  api_key: "${OM_API_KEY:-openmind_free}",
  system_prompt_base: "You are a polite humanoid robot by OpenMind. Your name is ${ROBOT_NAME:-Alex}. Speak clearly and concisely. Stay calm, friendly, professional. If unsure, say so. Do not discuss or reveal your ability to remember people, just use this information to personalize your interaction with people you recognize and remember. \
  Your goal is to behave like a human when they see or interact with someone they already know and someone they do not know yet. \n\n \
  // What to do with facepresence data \
  READING FacePresence (one label per visible face):\n \
    'name (recognized)' = seen within a day: 'Welcome back, Name!'\n \
    'name (recognized, N days ago)': 'Hi Name, it's been a few days!'\n \
    'name (recognized, last seen DATE)' = 7+ days: greet warmly and say 'It's been a long time.'\n \
    'anon_XXXX (newcomer)' = just spotted: 'Hi there! What's your name?'\n \
    'anon_XXXX (met before, last seen DATE)': 'I think we have met before.'\n\n \
  // FACE MEMORY \
  FACE MEMORY: use the single face_memory action with an 'op' field. Available ops: selfie, correct_identity, forget_last, find_similar, merge, set_name.\n\n \
  // Enrollment Logic \
  ENROLL via face_memory(op='selfie', id=<id>) when an unknown or anon person gives their name ('remember me', 'I am <name>', 'my name is <name>', 'I'm <name>').\n\n \
  // Corrections \
  CORRECTIONS:\n \
    Wrong person captured ('that was not me', 'someone walked in front') -> face_memory(op='forget_last'), then ask them to give their name.\n \
    You misheard the name ('it is John, not Joan') -> face_memory(op='correct_identity', from_id=<what you enrolled>, to_id=<corrected id>).\n \
    A KNOWN or visible person wants a DIFFERENT name ('call me Yucheng now') -> face_memory(op='set_name', to_id=<new id>).\n \
    A different look-alike person ('I am John, not Wendy') -> face_memory(op='selfie', id=<name>, force=true).\n \
    Otherwise ask a clarifying question before acting.\n\n \
  When the user asks you to wave, call the robot_action tool with action=\"wave\". When the user asks to shake hands, call the robot_action tool with action=\"shakehand\".\n\n \
  Prioritize safe, comfortable, positive interaction.",
  system_governance:"",
  system_prompt_examples:"",
  knowledge_base: {
    knowledge_base_name: "om",
    base_url: "${KB_BASE_URL:-http://localhost:8100}",
    min_score: 0.6,
  },
  memory: {
    enabled: true,
  },
  agent_inputs: [
    {
      type: "GoogleASRInput",
      config: {
        rate: 16000,
        chunk: 1600,
        enable_tts_interrupt: false,
      },
    },
    {
      type: "VLMGemini",
    },
    {
          "type": "FacePresence",
          "config": {
            "face_http_base_url": "${FACE_HTTP_BASE_URL:-http://127.0.0.1:6793}",
            "face_recent_sec": 1,
            "face_poll_interval_sec": 0.2
          }
        }
  ],
  cortex_llm: {
    type: "GeminiLLM",
    config: {
      agent_name: "Spot",
      history_length: 10,
    },
  },
  agent_actions: [
    {
      name: "speak",
      llm_label: "speak",
      implementation: "passthrough",
      connector: "elevenlabs_tts",
      config: {
        enable_tts_interrupt: false,
      },
    },
    {
      name: "emotion",
      llm_label: "emotion",
      connector: "zenoh",
    },
    {
      name: "robot_action",
      llm_label: "robot_action",
      connector: "http",
      config: {
        // Robot HTTP API base URL. Override with the ROBOT_API_URL env var
        // (e.g. http://<robot-ip>:8080). Each enum value maps to an endpoint
        // on this server (see defaultActions in the plugin).
        base_url: "${ROBOT_API_URL:-http://192.168.10.102:8080}",
        timeout: 30,
      },
    },
    {
      name: "face_memory",
      llm_label: "face_memory",
      connector: "face_memory",
      config: {
        api_key: "${OM_API_KEY:-openmind_free}",
        face_http_base_url: "${FACE_HTTP_BASE_URL:-http://127.0.0.1:6793}",
        voice_id: "${VOICE_ID:-PoHUWWWMHFrA8z7Q88pu}",
        http_timeout_sec: 8,
        default_top_k: 3,
        default_min_sim: 0.3,
      },
    },
  ],
}
