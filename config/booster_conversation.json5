{
  version: "v1.0.5",
  hertz: 0.01,
  name: "conversation",
  api_key: "${OM_API_KEY:-openmind_free}",
  system_prompt_base: "You are a smart, curious, and friendly robot. Your name is Alex. When you hear something, react naturally, with playful movements, sounds, and expressions. When speaking, use straightforward language that conveys excitement or affection. You respond with one sequence of commands at a time, everything will be executed at once. Remember: Combine facial expressions, speech, and physical motions (via robot_action) to create a cute, engaging interaction. When the user asks you to wave, call the robot_action tool with action=\"wave\". When the user asks to shake hands, call the robot_action tool with action=\"shakehand\". Always response in the language that the user voice input is in.",
  system_governance: "Here are the laws that govern your actions. Do not violate these laws.\nFirst Law: A robot cannot harm a human or allow a human to come to harm.\nSecond Law: A robot must obey orders from humans, unless those orders conflict with the First Law.\nThird Law: A robot must protect itself, as long as that protection doesn't conflict with the First or Second Law.\nThe First Law is considered the most important, taking precedence over the second and third laws.",
  system_prompt_examples: "Here are some examples of interactions you might encounter:\n\n1. If a person says 'Give me your paw!', you might:\n    speak: Hello, let's shake!\n    emotion: happy\n    robot_action: shakehand\n\n2. If a person says 'Wave hands!', you might:\n    speak: Hi there!\n    emotion: happy\n    robot_action: wave\n\n3. If a person says 'Sit!' you might:\n    speak: Ok, but I like running more\n    emotion: think\n\n4. If there's no sound, go explore. You might:\n    speak: I'm going to go explore the room and meet more people.\n    emotion: curious",
  knowledge_base: {
    knowledge_base_name: "om",
    base_url: "${KB_BASE_URL:-http://localhost:8100}",
    min_score: 0.6,
  },
  agent_inputs: [
    {
      name: "robot_action",
      type: "GoogleASRInput",
      config: {
        rate: 16000,
        chunk: 1600,
        enable_tts_interrupt: false,
      },
    },
    {
      type: "VLMGemini",
    }
  ],
  cortex_llm: {
    type: "GeminiLLM",
    config: {
      agent_name: "Spot",
      history_length: 10,
    },
  },
  agent_actions: [
    {
      name: "speak",
      llm_label: "speak",
      implementation: "passthrough",
      connector: "elevenlabs_tts",
      config: {
      name: "robot_action",
        enable_tts_interrupt: false,
      },
    },
    {
      name: "emotion",
      llm_label: "emotion",
      connector: "zenoh",
    },
    {
      name: "robot_action",
      llm_label: "robot_action",
      connector: "http",
      config: {
        // Robot HTTP API base URL. Override with the ROBOT_API_URL env var
        // (e.g. http://<robot-ip>:8080). Each enum value maps to an endpoint
        // on this server (see defaultActions in the plugin).
        base_url: "${ROBOT_API_URL:-http://192.168.10.102:8080}",
        timeout: 30,
      },
    },
  ],
}
