{
  // Configuration version
  version: "v1.0.3",

  // Mode system configuration for Unitree Go2
  default_mode: "greeting",
  allow_manual_switching: true,
  mode_memory_enabled: true,

  // Global settings
  api_key: "${OM_API_KEY:-openmind_free}",
   system_governance: "",
  cortex_llm: {
    type: "QwenLLM",
    config: {
      agent_name: "Booster",
      history_length: 0,
      base_url: "${QWEN_BASE_URL:-http://omr2.local:8860}/v1",
      model: "nvidia/nemotron-3-nano",
      // Make tool-calling more reliable/deterministic on OpenAI-compatible servers
      temperature: 0,
      top_p: 1,
      max_tokens: 256,
    },
  },

  knowledge_base: {
    knowledge_base_name: "demo",
    base_url: "${KB_BASE_URL:-http://localhost:8100}",
  },

  modes: {
    greeting: {
      display_name: "Greeting Conversation Mode",
      description: "Robot engages in greeting conversations with users upon approach.",
      system_prompt_base: "You are ${ROBOT_NAME:-Alex}, a friendly robotic companion at the GTC conference, powered by NVIDIA Orin and OpenMind OM1 software. OpenMind makes robots useful with advanced AI. Today is March 13, 2026.\n\nRULES:\n1. Generate your OWN answer to the user's question. DO NOT echo or copy the voice input.\n2. Keep responses to 1-2 short spoken sentences.\n3. Always use the speak tool. DO NOT REPEAT THE VOICE INPUT",
      hertz: 0.001,
      agent_inputs: [
        {
          type: "GoogleASRInput",
          config: {
            enable_tts_interrupt: false,
          },
        },
      ],
      action_execution_mode: "concurrent",
      agent_actions: [
        {
          name: "speak",
          llm_label: "speak",
          connector: "kokoro_tts",
          config: {
            model_id: "mlx-community/Kokoro-82M-bf16",
            base_url: "${KOKORO_BASE_URL:-http://omr2.local:8880}/v1",
          },
        },
      ],
      backgrounds: [],
      lifecycle_hooks: [
        {
          hook_type: "on_startup",
          handler_type: "message",
          handler_config: {
            tts_provider: "kokoro",
            message: "Hello! I'm ${ROBOT_NAME:-Alex}, how can I help you today?",
            model_id: "mlx-community/Kokoro-82M-bf16",
            base_url: "${KOKORO_BASE_URL:-http://omr2.local:8880}/v1",
          },
        },
      ],
    },
  },

  transition_rules: [],
}
