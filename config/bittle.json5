    {
      name: "bittle",
      llm_label: "bittle_rest",
      connector: "ble",
      config: {
        command: "krest",
        device_address: "${BITTLE_BLE_ADDRESS:-}",
        device_name: "${BITTLE_BLE_NAME:-BittleA6_SSP}",
        simulate: "${BITTLE_SIMULATE:-false}",
      },
    },
    {
      name: "bittle",
      llm_label: "bittle_step_in_place",
