        simulate: "${BITTLE_SIMULATE:-false}",
      },
    },
    {
      name: "adjust_bittle_calibration",
      llm_label: "bittle_adjust_calibration",
      connector: "ble",
      config: {
        device_address: "${BITTLE_BLE_ADDRESS:-}",
        device_name: "${BITTLE_BLE_NAME:-BittleA6_SSP}",
