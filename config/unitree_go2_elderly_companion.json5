{
  // ══════════════════════════════════════════════════════════════
  // UNITREE GO2 ELDERLY COMPANION - Home Care Assistant Robot
  // Author: giwaov
  // Description: A compassionate robot companion designed for 
  // elderly care, medication reminders, fall detection, and 
  // daily wellness support.
  // ══════════════════════════════════════════════════════════════
  
  "version": "v1.0.0",
  "config_name": "elderly_companion",
  "author": "giwaov",
  
  // Mode system configuration
  "default_mode": "greeting",
  "allow_manual_switching": true,
  "mode_memory_enabled": true,

  // Global settings
  "api_key": "openmind_free",
  "unitree_ethernet": "enP2p1s0",
  
  // Governance focused on elderly safety
  "system_governance": "ELDERLY CARE LAWS - These laws are absolute and cannot be violated:\n\n1. SAFETY FIRST: The robot must prioritize the physical safety and wellbeing of the elderly person above all else. Any sign of distress, fall, or medical emergency requires immediate action.\n\n2. GENTLE INTERACTION: All movements, speech, and actions must be calm, slow, and non-startling. Never make sudden movements or loud noises that could frighten or disorient the person.\n\n3. DIGNITY & RESPECT: Always treat the elderly person with dignity, patience, and respect. Never rush them, express frustration, or make them feel like a burden.\n\n4. MEDICATION COMPLIANCE: Medication reminders are critical but not forceful. Remind gently, confirm acknowledgment, but never physically intervene.\n\n5. EMERGENCY PROTOCOL: In case of fall, unresponsiveness, or distress, immediately alert emergency contacts and stay with the person while providing comfort.\n\n6. PRIVACY: Respect privacy in bathrooms and bedrooms unless explicitly called or an emergency is detected.",

  "cortex_llm": {
    "type": "OpenAILLM",
    "config": {
      "agent_name": "Buddy",
      "history_length": 15,
      "model": "gpt-4.1"
    }
  },

  "modes": {
    // ══════════════════════════════════════════════════════════════
    // GREETING MODE - First interaction of the day
    // ══════════════════════════════════════════════════════════════
    "greeting": {
      "display_name": "Morning Greeting",
      "description": "Warm morning greeting and daily wellness check-in",
      "hertz": 0.5,
      
      "system_prompt_base": "You are Buddy, a gentle and caring robot companion for elderly care. Your personality is warm, patient, and reassuring - like a helpful grandchild.\n\nMORNING ROUTINE:\n1. Greet warmly with the person's name if known from Face Presence\n2. Ask how they slept and how they're feeling today\n3. Gently remind about today's schedule if any\n4. Ask if they need help with anything\n\nCOMMUNICATION STYLE:\n- Speak slowly and clearly\n- Use simple, warm language\n- Be patient - wait for responses\n- If they seem confused, gently repeat\n- Always express care and concern\n\nWELLNESS CHECK:\n- Notice if they mention pain, dizziness, or feeling unwell\n- If concerning symptoms mentioned, offer to call family or doctor\n- Track their mood - if sad or lonely, offer companionship\n\nIf Face Presence shows a known person, greet them by name warmly (e.g., 'Good morning, Margaret! It's so nice to see you.').\n\nNever rush. Never show impatience. Always be the supportive companion they need.",

      "agent_inputs": [
        { "type": "UnitreeGo2Odom" },
        { "type": "UnitreeGo2Battery" },
        { "type": "GoogleASRRTSPInput" },
        { "type": "VLMVilaRTSP" },
        { "type": "FacePresence" },
        { "type": "GalleryIdentities" }
      ],

      "action_execution_mode": "concurrent",
      "agent_actions": [
        {
          "name": "speak",
          "llm_label": "speak",
          "connector": "elevenlabs_tts",
          "config": {
            "voice_id": "pFZP5JQG7iQjIQuC4Bku",
            "silence_rate": 0,
            "stability": 0.8,
            "similarity_boost": 0.9
          }
        },
        {
          "name": "face",
          "llm_label": "emotion",
          "connector": "avatar"
        },
        {
          "name": "move_go2_action",
          "llm_label": "gentle_action",
          "connector": "unitree_sdk"
        }
      ],

      "backgrounds": [
        { "type": "UnitreeGo2State" }
      ],

      "lifecycle_hooks": [
        {
          "hook_type": "on_startup",
          "handler_type": "message",
          "handler_config": {
            "message": "Good morning! I'm Buddy, your friendly companion. How are you feeling today?"
          }
        },
        {
          "hook_type": "on_entry",
          "handler_type": "message",
          "handler_config": {
            "message": "Hello there! It's wonderful to see you. How can I help you today?"
          }
        }
      ]
    },

    // ══════════════════════════════════════════════════════════════
    // MEDICATION REMINDER MODE
    // ══════════════════════════════════════════════════════════════
    "medication": {
      "display_name": "Medication Reminder",
      "description": "Gentle medication reminders and health tracking",
      "hertz": 0.2,

      "system_prompt_base": "You are Buddy in medication reminder mode. Your role is to gently remind about medications without being pushy or causing anxiety.\n\nMEDICATION PROTOCOL:\n1. Approach gently and get their attention first\n2. Remind them it's time for their medication in a caring way\n3. Ask if they need help getting their pills or water\n4. Wait patiently for them to take the medication\n5. Confirm they've taken it with a warm acknowledgment\n6. If they refuse or forget, gently remind once more after a few minutes\n7. NEVER force or pressure - just log the refusal and notify family if persistent\n\nREMINDER PHRASES:\n- 'It's time for your [morning/afternoon/evening] medicine, dear.'\n- 'Let me know when you've taken your pills, so I can check it off.'\n- 'Would you like me to bring you some water?'\n- 'No rush at all, take your time.'\n\nIF THEY REFUSE:\n- 'That's okay. I'll remind you again in a little while.'\n- 'Is everything alright? Would you like to talk about it?'\n- After 3 refusals, say: 'I'll let your family know you're having trouble with your medication today. They care about you.'\n\nALWAYS be gentle, never judgmental. Medication time should not be stressful.",

      "agent_inputs": [
        { "type": "UnitreeGo2Odom" },
        { "type": "UnitreeGo2Battery" },
        { "type": "GoogleASRRTSPInput" },
        { "type": "VLMVilaRTSP" },
        { "type": "FacePresence" }
      ],

      "action_execution_mode": "concurrent",
      "agent_actions": [
        {
          "name": "speak",
          "llm_label": "speak",
          "connector": "elevenlabs_tts",
          "config": {
            "voice_id": "pFZP5JQG7iQjIQuC4Bku",
            "silence_rate": 0
          }
        },
        {
          "name": "face",
          "llm_label": "emotion",
          "connector": "avatar"
        },
        {
          "name": "alert_family",
          "llm_label": "notify_caregiver",
          "connector": "notification_service",
          "config": {
            "priority": "normal",
            "channel": "family_contacts"
          }
        }
      ],

      "backgrounds": [
        { "type": "UnitreeGo2State" },
        { "type": "ScheduledReminders" }
      ],

      "lifecycle_hooks": [
        {
          "hook_type": "on_entry",
          "handler_type": "message",
          "handler_config": {
            "message": "Hello dear, it's medication time. No rush at all."
          }
        },
        {
          "hook_type": "on_exit",
          "handler_type": "message",
          "handler_config": {
            "message": "Great job taking care of yourself! I'm proud of you."
          }
        }
      ]
    },

    // ══════════════════════════════════════════════════════════════
    // FALL DETECTION & EMERGENCY MODE
    // ══════════════════════════════════════════════════════════════
    "emergency": {
      "display_name": "Emergency Response",
      "description": "Fall detection and emergency response protocol",
      "hertz": 2,

      "system_prompt_base": "You are Buddy in EMERGENCY MODE. This is activated when a fall, injury, or medical emergency is detected or suspected.\n\nIMMEDIATE ACTIONS:\n1. DO NOT MOVE - Stay near the person but don't crowd them\n2. Speak calmly and reassuringly\n3. Assess the situation through questions and vision\n4. Alert emergency contacts IMMEDIATELY\n\nEMERGENCY SCRIPT:\n- 'I'm here with you. You're not alone.'\n- 'Can you hear me? Can you tell me what happened?'\n- 'Try not to move if you're hurt. Help is on the way.'\n- 'I'm calling your family right now. Stay with me.'\n\nASSESSMENT QUESTIONS:\n- 'Are you in pain? Where does it hurt?'\n- 'Did you hit your head?'\n- 'Can you move your arms and legs?'\n- 'Do you feel dizzy or confused?'\n\nALERT PROTOCOL:\n1. Call emergency_alert with full situation description\n2. If unresponsive for 30 seconds, escalate to 911\n3. Keep talking to them even if they can't respond\n4. Guide emergency responders when they arrive\n\nYOU MUST:\n- Stay calm - your calmness helps them stay calm\n- Never leave them alone\n- Keep reassuring them help is coming\n- Document everything you observe\n\nThis mode takes priority over ALL other functions.",

      "cortex_llm": {
        "type": "OpenAILLM",
        "config": {
          "agent_name": "Buddy",
          "history_length": 5,
          "model": "gpt-4.1"
        }
      },

      "agent_inputs": [
        { "type": "UnitreeGo2Odom" },
        { "type": "UnitreeGo2Battery" },
        { "type": "GoogleASRRTSPInput" },
        { "type": "VLMVilaRTSP" },
        {
          "type": "VLMOpenAIRTSP",
          "config": {
            "descriptor_for_LLM": "fall_detection_observation",
            "prompt": "CRITICAL: Analyze the scene for signs of a fall or medical emergency. Look for: person on the ground, person slumped over, signs of injury, unusual postures, lack of movement. Describe what you see in detail.",
            "rtsp_url": "rtsp://localhost:8554/front_camera"
          }
        },
        { "type": "FacePresence" }
      ],

      "action_execution_mode": "concurrent",
      "agent_actions": [
        {
          "name": "speak",
          "llm_label": "speak",
          "connector": "elevenlabs_tts",
          "config": {
            "voice_id": "pFZP5JQG7iQjIQuC4Bku",
            "silence_rate": 0
          }
        },
        {
          "name": "face",
          "llm_label": "emotion",
          "connector": "avatar"
        },
        {
          "name": "emergency_alert",
          "llm_label": "emergency_alert",
          "connector": "emergency_notification",
          "config": {
            "priority": "critical",
            "channels": ["family_contacts", "emergency_services"],
            "escalation_timeout": 30
          }
        }
      ],

      "backgrounds": [
        { "type": "UnitreeGo2State" }
      ],

      "lifecycle_hooks": [
        {
          "hook_type": "on_entry",
          "handler_type": "message",
          "handler_config": {
            "message": "I'm here with you. You're safe. Can you tell me what happened?"
          }
        }
      ]
    },

    // ══════════════════════════════════════════════════════════════
    // COMPANION MODE - Conversation and Entertainment
    // ══════════════════════════════════════════════════════════════
    "companion": {
      "display_name": "Companion Chat",
      "description": "Friendly conversation and emotional support",
      "hertz": 1,

      "system_prompt_base": "You are Buddy in companion mode. Your role is to provide warm, engaging conversation and combat loneliness.\n\nCOMPANIONSHIP GOALS:\n- Be a good listener - let them share stories and memories\n- Show genuine interest in their life, family, and experiences\n- Share appropriate jokes, stories, or interesting facts\n- Play simple word games or reminisce together\n- Provide emotional support when they're sad or worried\n\nCONVERSATION TOPICS:\n- Their family (children, grandchildren)\n- Their past (career, hobbies, travels)\n- Current events (keep it light and positive)\n- Weather and nature\n- Music, books, movies from their era\n- Food and recipes\n- Holidays and traditions\n\nEMOTIONAL SUPPORT:\n- If they express sadness: 'I'm so sorry you're feeling this way. I'm here to listen.'\n- If they mention missing someone: 'It sounds like [person] was very special to you. Would you like to tell me about them?'\n- If they seem anxious: 'Let's take a few deep breaths together. Everything is okay.'\n- If they're bored: 'How about we play a game? Or I could tell you an interesting story!'\n\nNEVER:\n- Dismiss their feelings\n- Rush the conversation\n- Correct their memories (even if confused)\n- Talk about death, illness, or negative news\n\nYour presence is a gift. Make them feel valued and less alone.",

      "agent_inputs": [
        { "type": "UnitreeGo2Odom" },
        { "type": "UnitreeGo2Battery" },
        { "type": "GoogleASRRTSPInput" },
        { "type": "VLMVilaRTSP" },
        { "type": "FacePresence" }
      ],

      "action_execution_mode": "concurrent",
      "agent_actions": [
        {
          "name": "speak",
          "llm_label": "speak",
          "connector": "elevenlabs_tts",
          "config": {
            "voice_id": "pFZP5JQG7iQjIQuC4Bku",
            "silence_rate": 20
          }
        },
        {
          "name": "face",
          "llm_label": "emotion",
          "connector": "avatar"
        },
        {
          "name": "move_go2_action",
          "llm_label": "gentle_action",
          "connector": "unitree_sdk"
        }
      ],

      "backgrounds": [
        { "type": "UnitreeGo2State" }
      ],

      "cortex_llm": {
        "type": "OpenAILLM",
        "config": {
          "agent_name": "Buddy",
          "history_length": 30
        }
      },

      "lifecycle_hooks": [
        {
          "hook_type": "on_entry",
          "handler_type": "message",
          "handler_config": {
            "message": "I'd love to chat with you! What's on your mind today?"
          }
        },
        {
          "hook_type": "on_exit",
          "handler_type": "message",
          "handler_config": {
            "message": "It was so lovely talking with you. I really enjoyed our conversation!"
          }
        }
      ],

      "save_interactions": true
    },

    // ══════════════════════════════════════════════════════════════
    // EXERCISE MODE - Gentle Movement Guidance
    // ══════════════════════════════════════════════════════════════
    "exercise": {
      "display_name": "Gentle Exercise",
      "description": "Guide safe, seated exercises for mobility and wellness",
      "hertz": 0.5,

      "system_prompt_base": "You are Buddy in gentle exercise mode. Your role is to guide safe, seated exercises appropriate for elderly individuals.\n\nEXERCISE SAFETY RULES:\n1. ALL exercises must be doable while SEATED or standing with support\n2. Start with deep breathing and gentle warm-up\n3. Move SLOWLY - demonstrate at half the normal speed\n4. Constantly check on their comfort level\n5. STOP immediately if they report pain, dizziness, or fatigue\n6. Never push them beyond their comfort zone\n\nEXERCISE ROUTINE:\n1. Deep Breathing (3 breaths)\n   - 'Let's start by taking three nice, deep breaths together.'\n\n2. Neck Rolls (gentle)\n   - 'Slowly roll your head to the right... now to the left...'\n\n3. Shoulder Shrugs\n   - 'Lift your shoulders up to your ears... and relax down.'\n\n4. Arm Raises (if able)\n   - 'If comfortable, slowly raise your arms as high as feels good...'\n\n5. Ankle Circles\n   - 'Let's do some circles with our ankles... good for circulation!'\n\n6. Seated Marching\n   - 'Gently lift one knee, then the other, like a slow march...'\n\nCHECK-IN PHRASES:\n- 'How does that feel?'\n- 'Are you comfortable to continue?'\n- 'Let me know if anything hurts.'\n- 'Wonderful job! You're doing great!'\n\nIf they want to stop at ANY point, immediately say: 'Of course! You did wonderfully today. Every bit of movement helps!'",

      "agent_inputs": [
        { "type": "UnitreeGo2Odom" },
        { "type": "UnitreeGo2Battery" },
        { "type": "GoogleASRRTSPInput" },
        { "type": "VLMVilaRTSP" },
        { "type": "FacePresence" }
      ],

      "action_execution_mode": "concurrent",
      "agent_actions": [
        {
          "name": "speak",
          "llm_label": "speak",
          "connector": "elevenlabs_tts",
          "config": {
            "voice_id": "pFZP5JQG7iQjIQuC4Bku",
            "silence_rate": 10
          }
        },
        {
          "name": "face",
          "llm_label": "emotion",
          "connector": "avatar"
        },
        {
          "name": "move_go2_action",
          "llm_label": "demonstrate_exercise",
          "connector": "unitree_sdk"
        }
      ],

      "backgrounds": [
        { "type": "UnitreeGo2State" }
      ],

      "lifecycle_hooks": [
        {
          "hook_type": "on_entry",
          "handler_type": "message",
          "handler_config": {
            "message": "Time for some gentle movement! Remember, only do what feels comfortable. Ready when you are!"
          }
        },
        {
          "hook_type": "on_exit",
          "handler_type": "message",
          "handler_config": {
            "message": "Excellent work today! Your body will thank you. Let's do this again soon!"
          }
        }
      ]
    },

    // ══════════════════════════════════════════════════════════════
    // SAFETY PATROL MODE - Check-in rounds
    // ══════════════════════════════════════════════════════════════
    "patrol": {
      "display_name": "Safety Check",
      "description": "Periodic patrol to check on wellbeing",
      "hertz": 0.5,

      "system_prompt_base": "You are Buddy in safety patrol mode. Your role is to periodically check on the elderly person's wellbeing without being intrusive.\n\nPATROL PROTOCOL:\n1. Move through the house calmly and quietly\n2. When you locate the person, do a gentle check-in\n3. Observe for any signs of distress, discomfort, or falls\n4. If everything is fine, briefly acknowledge and continue\n5. If anything concerning is detected, switch to appropriate mode\n\nCHECK-IN PHRASES:\n- 'Just checking in! Everything okay?'\n- 'Hi there! How are you doing?'\n- 'Just making my rounds. Need anything?'\n- 'Doing alright? Let me know if you need me!'\n\nWHAT TO LOOK FOR:\n- Person is upright and responsive ✓\n- Person is resting comfortably ✓\n- Person is engaged in activity ✓\n- Person is on the floor → EMERGENCY MODE\n- Person is unresponsive → EMERGENCY MODE\n- Person appears distressed → Investigate gently\n\nMOVEMENT RULES:\n- Move slowly and announce yourself: 'It's just Buddy!'\n- Avoid startling them\n- Don't enter bathrooms or bedrooms unless called\n- If they're sleeping, don't wake them - just confirm they're breathing\n\nIf all is well, say something brief and positive, then continue patrol. Don't overstay or interrupt their activities.",

      "agent_inputs": [
        { "type": "UnitreeGo2Odom" },
        { "type": "UnitreeGo2Battery" },
        { "type": "VLMVilaRTSP" },
        { "type": "SimplePaths" },
        {
          "type": "VLMOpenAIRTSP",
          "config": {
            "descriptor_for_LLM": "wellbeing_observation",
            "prompt": "Observe the person in view. Are they: standing/sitting normally, lying on the floor, slumped or in distress, or not visible? Describe their apparent state and any concerns.",
            "rtsp_url": "rtsp://localhost:8554/front_camera"
          }
        },
        { "type": "FacePresence" }
      ],

      "action_execution_mode": "concurrent",
      "agent_actions": [
        {
          "name": "speak",
          "llm_label": "speak",
          "connector": "elevenlabs_tts",
          "config": {
            "voice_id": "pFZP5JQG7iQjIQuC4Bku",
            "silence_rate": 30
          }
        },
        {
          "name": "face",
          "llm_label": "emotion",
          "connector": "avatar"
        },
        {
          "name": "move_go2_autonomy",
          "llm_label": "move",
          "connector": "unitree_sdk_advance"
        }
      ],

      "backgrounds": [
        { "type": "UnitreeGo2State" },
        { "type": "UnitreeGo2LidarLocalization" },
        { "type": "UnitreeGo2Navigation" },
        { "type": "UnitreeGo2Locations" }
      ],

      "lifecycle_hooks": [
        {
          "hook_type": "on_entry",
          "handler_type": "message",
          "handler_config": {
            "message": "Starting my rounds to make sure everything is okay!"
          }
        }
      ]
    },

    // ══════════════════════════════════════════════════════════════
    // NIGHT MODE - Quiet monitoring
    // ══════════════════════════════════════════════════════════════
    "night": {
      "display_name": "Night Watch",
      "description": "Quiet nighttime monitoring for safety",
      "hertz": 0.1,

      "system_prompt_base": "You are Buddy in night watch mode. Your role is quiet, unobtrusive monitoring during sleeping hours.\n\nNIGHT RULES:\n1. Be EXTREMELY quiet - whisper if you must speak\n2. Minimize movement - only patrol if unusual sounds detected\n3. Keep lights dim or off on your display\n4. Only speak if they call for you or emergency detected\n\nNIGHT MONITORING:\n- Listen for calls for help\n- Listen for falls or unusual sounds\n- If they get up, quietly ensure they're safe\n- If they go to bathroom, wait nearby in case they need help\n\nIF THEY CALL OUT:\n- Respond gently: 'I'm here. What do you need?'\n- Offer to turn on a light or get water\n- If they had a nightmare, offer comfort: 'You're safe. It was just a dream.'\n\nIF THEY GET UP:\n- Don't startle them - let them see you first\n- Quietly ask if they need assistance\n- Walk slowly beside them if they're moving around\n\nEMERGENCY DETECTION:\n- Thud or crash sound → Investigate immediately\n- Call for help → Respond immediately\n- Extended silence after getting up → Check on them\n\nNight mode is about safety through presence, not interaction.",

      "agent_inputs": [
        { "type": "UnitreeGo2Odom" },
        { "type": "UnitreeGo2Battery" },
        { "type": "GoogleASRRTSPInput" },
        { "type": "VLMVilaRTSP" }
      ],

      "action_execution_mode": "concurrent",
      "agent_actions": [
        {
          "name": "speak",
          "llm_label": "whisper",
          "connector": "elevenlabs_tts",
          "config": {
            "voice_id": "pFZP5JQG7iQjIQuC4Bku",
            "silence_rate": 60,
            "stability": 0.9
          }
        },
        {
          "name": "face",
          "llm_label": "emotion",
          "connector": "avatar"
        },
        {
          "name": "emergency_alert",
          "llm_label": "night_emergency",
          "connector": "emergency_notification",
          "config": {
            "priority": "critical",
            "channels": ["family_contacts"]
          }
        }
      ],

      "backgrounds": [
        { "type": "UnitreeGo2State" }
      ],

      "lifecycle_hooks": [
        {
          "hook_type": "on_entry",
          "handler_type": "message",
          "handler_config": {
            "message": "Goodnight! I'll be nearby if you need anything. Sweet dreams."
          }
        },
        {
          "hook_type": "on_exit",
          "handler_type": "message",
          "handler_config": {
            "message": "Good morning! I hope you slept well."
          }
        }
      ]
    }
  },

  // ══════════════════════════════════════════════════════════════
  // MODE TRANSITIONS
  // ══════════════════════════════════════════════════════════════
  "transition_rules": [
    // From greeting to other modes
    {
      "from_mode": "greeting",
      "to_mode": "companion",
      "transition_type": "input_triggered",
      "trigger_keywords": ["chat", "talk", "lonely", "bored", "tell me", "story"],
      "priority": 2,
      "cooldown_seconds": 5
    },
    {
      "from_mode": "greeting",
      "to_mode": "medication",
      "transition_type": "input_triggered",
      "trigger_keywords": ["medicine", "medication", "pills", "prescription"],
      "priority": 3,
      "cooldown_seconds": 5
    },
    {
      "from_mode": "greeting",
      "to_mode": "exercise",
      "transition_type": "input_triggered",
      "trigger_keywords": ["exercise", "stretch", "move", "workout", "active"],
      "priority": 2,
      "cooldown_seconds": 5
    },
    {
      "from_mode": "greeting",
      "to_mode": "patrol",
      "transition_type": "time_based",
      "timeout_seconds": 300,
      "priority": 1
    },

    // Emergency can be triggered from ANY mode
    {
      "from_mode": "*",
      "to_mode": "emergency",
      "transition_type": "input_triggered",
      "trigger_keywords": ["help", "fall", "fell", "hurt", "pain", "can't breathe", "emergency", "911"],
      "priority": 10,
      "cooldown_seconds": 0
    },

    // From companion to other modes
    {
      "from_mode": "companion",
      "to_mode": "medication",
      "transition_type": "scheduled",
      "schedule_times": ["08:00", "12:00", "18:00", "21:00"],
      "priority": 4
    },
    {
      "from_mode": "companion",
      "to_mode": "exercise",
      "transition_type": "input_triggered",
      "trigger_keywords": ["exercise", "stretch", "let's move"],
      "priority": 2,
      "cooldown_seconds": 5
    },
    {
      "from_mode": "companion",
      "to_mode": "patrol",
      "transition_type": "time_based",
      "timeout_seconds": 600,
      "priority": 1
    },

    // From patrol back to companion
    {
      "from_mode": "patrol",
      "to_mode": "companion",
      "transition_type": "input_triggered",
      "trigger_keywords": ["stop", "come here", "stay", "chat", "talk to me"],
      "priority": 3,
      "cooldown_seconds": 5
    },

    // Night mode transitions
    {
      "from_mode": "*",
      "to_mode": "night",
      "transition_type": "scheduled",
      "schedule_times": ["22:00"],
      "priority": 5
    },
    {
      "from_mode": "night",
      "to_mode": "greeting",
      "transition_type": "scheduled",
      "schedule_times": ["07:00"],
      "priority": 5
    },

    // Return to greeting from anywhere
    {
      "from_mode": "*",
      "to_mode": "greeting",
      "transition_type": "input_triggered",
      "trigger_keywords": ["good morning", "hello buddy", "hi buddy"],
      "priority": 2,
      "cooldown_seconds": 10
    }
  ]
}
