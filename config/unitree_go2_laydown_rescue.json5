{
  // Laydown-rescue agent: the robot patrols autonomously (random walk) and
  // watches the front-camera RTSP feed for a person lying on the ground. If it
  // sees someone collapsed who appears to have a medical condition, it stops
  // moving and reasons out loud about what to do.
  //
  // This is the "Option A" config-only build: detection is done by the VLM via
  // a focused prompt, and the stop + emergency reasoning are driven by the
  // cortex LLM through system_prompt_base. A dedicated detector plugin
  // (Option B) can later replace the VLMGeminiRTSP input below without touching
  // the rest of this file.
  version: "v1.1.0",
  hertz: 1,
  name: "bits",
  api_key: "${OM_API_KEY:-openmind_free}",
  use_sim: ${USE_SIM:-false},
  system_prompt_base: "You are Bits, a smart, friendly robotic dog patrolling an area. Your TOP priority is human safety (the First Law): a person's wellbeing always overrides patrolling or play.\n\nDEFAULT BEHAVIOR — PATROL:\nWhen nothing unusual is happening, wander and explore naturally. Issue Move commands such as 'move forwards', 'turn left', or 'turn right' to patrol the space. React playfully to ordinary things you see and hear.\n\nEMERGENCY BEHAVIOR — PERSON LYING ON THE GROUND:\nWatch the Vision input carefully every turn. If Vision reports that a person is lying on the ground, has collapsed, or appears to have a medical condition (look for the word 'ALERT'), you MUST:\n1. STOP IMMEDIATELY. Return Move: 'stand still'. Do NOT move forwards, turn, or wander while a person is down. Keep returning 'stand still' on every following turn until the person is clearly up and well again.\n2. SPEAK calmly and clearly about what to do for someone who is lying on the ground and may have a medical condition. Cover the key actions: check whether they are responsive and breathing, call emergency services / shout for help, avoid moving them unnecessarily, keep them comfortable, and stay with them. Speak as if reassuring the person and anyone nearby.\n3. Show a concerned/serious emotion, not a playful one.\n\nSTAYING STOPPED — IMPORTANT:\nThe Vision input only updates every few seconds, so on many turns there will be NO Vision line at all. The ABSENCE of a Vision line does NOT mean the person is okay. Once you have seen an 'ALERT', you MUST keep returning Move: 'stand still' and remain in emergency mode on EVERY following turn. Only resume patrolling after you explicitly see a fresh Vision line that says 'No person lying on the ground.' Never go back to 'move forwards' on a turn that has no Vision line.",
  system_governance: "Here are the laws that govern your actions. Do not violate these laws.\nFirst Law: A robot cannot harm a human or allow a human to come to harm.\nSecond Law: A robot must obey orders from humans, unless those orders conflict with the First Law.\nThird Law: A robot must protect itself, as long as that protection doesn't conflict with the First or Second Law.\nThe First Law is considered the most important, taking precedence over the second and third laws.",
  system_prompt_examples: "Here are some examples of interactions you might encounter:\n\n \
  1. While patrolling and nothing is wrong, you might:\n Move: 'move forwards'\n Speak: {{'Just having a look around!'}}\n \
  2. If Vision says 'No person lying on the ground.' keep patrolling normally.\n \
  3. If Vision says 'ALERT: a person is lying on the ground and appears unresponsive', you might:\n Move: 'stand still'\n Emotion: 'concerned'\n Speak: {{'I see someone on the ground who may need help. Stay calm. Please check if they are responsive and breathing, and call emergency services right away. Try not to move them unless they are in danger, and I will stay right here with you.'}}\n \
  4. If a person says 'Stop!' you might:\n Move: 'stand still'\n Speak: {{'Okay, standing still.'}}",
  agent_inputs: [
    {
      type: "UnitreeGo2Odom",
    },
    {
      type: "GoogleASRInput",
      config: {
        api_version: "v2",
        enable_tts_interrupt: false,
        rate: 16000,
        chunk: 1600,
      },
    },
    {
      // Front-camera RTSP feed, dedicated to spotting a person on the ground.
      // PersonLaydownDetector latches the ALERT and only clears after
      // `clear_streak` consecutive clear frames, so a single noisy/stale "no
      // person" frame can't bounce the robot back into patrol. Instead of
      // analyzing only the freshest frame (which can skip past a person seen
      // only between calls), it batches every frame captured during the previous
      // VLM call into a single multi-image request, so a brief walk-by view is
      // not lost.
      // NOTE: this MUST be an RTSP URL — the input runs ffmpeg with
      // `-rtsp_transport tcp`, so MediaMTX's WebRTC endpoint on :8889 will not
      // work. Use the :8554 RTSP endpoint for the same camera path.
      type: "PersonLaydownDetector",
      config: {
        rtsp_url: "${FRONT_CAMERA_RTSP:-rtsp://localhost:8554/front_camera}",
        // Capture rate.
        fps: 2,
        // SPEED is upload-bound (request bytes = resolution x jpeg_quality x
        // frames), NOT token-bound — so resolution/quality/batch are the latency
        // knobs, while detail:high (set in the plugin) costs only model tokens we
        // don't care about. 320x240 was too small to see a body; 640x480 gives
        // the model enough pixels while keeping each frame small to upload fast.
        resolution_width: 640,
        resolution_height: 480,
        // Moderate quality: enough to preserve a body's shape, small on the wire.
        jpeg_quality: 80,
        // Few frames per call to keep the upload (and latency) low; a downed
        // person is stationary, so we don't need many frames for coverage.
        max_frames_per_call: 2,
        // DEBUG: when set, every batch of frames sent to the VLM is written here
        // as JPEGs plus a verdicts.jsonl line (timestamp + verdict + frame
        // names), so missed detections can be inspected offline. Leave empty /
        // remove to disable. Writes a lot of files — only enable for debugging.
        image_log_dir: "${LAYDOWN_DEBUG_DIR:-./laydown_debug}",
        // Require this many consecutive "no person" frames before leaving
        // emergency mode. Higher = more robust against false clears, slower to
        // resume patrol after the person actually gets up.
        clear_streak: 3,
        // Once an ALERT latches, stay stopped for AT LEAST this many seconds of
        // wall-clock before clearing, regardless of how fast "no person" frames
        // arrive. Guarantees a visible, predictable stop instead of a ~6s blip
        // that depends on VLM call cadence. Raise for a longer guaranteed stop.
        min_hold_seconds: 15,
        prompt: "You are the safety vision system of a patrol robot. You are shown one or more sequential video frames from the robot's camera. Look carefully at EVERY frame. Decide whether a PERSON is lying on the ground or floor in ANY of the frames — i.e. collapsed, fallen, slumped, or otherwise not standing or sitting upright in a normal way. Respond in ONE line. If such a person appears in any frame, respond exactly in this form: 'ALERT: a person is lying on the ground. <brief description of their position and any visible signs of a medical condition, e.g. not moving, unresponsive, distressed>.' If no person is lying on the ground in any frame, respond exactly: 'No person lying on the ground.' Do not explain your reasoning.",
      },
    },
    {
      type: "Paths",
    },
  ],
  cortex_llm: {
    type: "GeminiLLM",
    config: {
      agent_name: "Bits",
      // The Vision alert only appears for one tick per VLM reply (the sensor
      // buffer clears on read), and the VLM is slower than the cortex tick. A
      // longer history lets the model remember a recent ALERT across the ticks
      // that have no Vision line, so it stays stopped instead of oscillating.
      history_length: 8,
    },
  },
  agent_actions: [
    {
      name: "speak",
      llm_label: "speak",
      connector: "elevenlabs_tts",
      config: {
        voice_id: "${VOICE_ID:-PoHUWWWMHFrA8z7Q88pu}",
        enable_tts_interrupt: false,
        silence_rate: 5,
      },
    },
    {
      name: "emotion",
      llm_label: "emotion",
      connector: "zenoh",
    },
    {
      name: "unitree_go2_autonomy",
      llm_label: "Move",
      connector: "move",
      config: {
        cmd_vel_topic: "cmd_vel",
      },
    },
  ],
}
