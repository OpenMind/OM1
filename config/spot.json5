{
  "version": "1.0.0",
  "name": "spot_survival_mode",
  
  // 虚拟网络
  "robot_ip": "127.0.0.1",

  // 补齐必要参数，防止报错退出
  "hertz": 1,
  // 【关键】全部设为空！这样初始化时流量最小/为零。
  "system_prompt_base": "",
  "system_governance": "",
  "system_prompt_examples": "",

  // 输入源为空 = 不触发思考
  "agent_inputs": [],
  "agent_actions": [],

  // 【修正】改回 OpenAILLM 以通过代码检查
  // 虽然是 OpenAI，但因为下面 inputs 是空的，它没有触发源。
  "cortex_llm": {
    "type": "OpenAILLM",
    "config": {
      "agent_name": "Spot",
      "history_length": 0
    }
  },

  // 模拟器保活
  "simulators": [
    {
      "type": "WebSim",
      "config": {
        "host": "0.0.0.0",
        "port": 8000,
        "tick_rate": 100,
        "auto_reconnect": true,
        "debug_mode": false
      }
    }
  ]
}