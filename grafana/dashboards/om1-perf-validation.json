        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(rate(om1_request_total_seconds_sum{kind=\"llm\"}[1m]) / rate(om1_request_total_seconds_count{kind=\"llm\"}[1m])) - ((rate(om1_request_proxy_seconds_sum{kind=\"llm\"}[1m]) / rate(om1_request_proxy_seconds_count{kind=\"llm\"}[1m])) or ((rate(om1_request_total_seconds_sum{kind=\"llm\"}[1m]) / rate(om1_request_total_seconds_count{kind=\"llm\"}[1m])) * 0))",
          "legendFormat": "LLM (total \u2212 proxy)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(rate(om1_request_total_seconds_sum{kind=\"tts\"}[1m]) / rate(om1_request_total_seconds_count{kind=\"tts\"}[1m])) - ((rate(om1_request_proxy_seconds_sum{kind=\"tts\"}[1m]) / rate(om1_request_proxy_seconds_count{kind=\"tts\"}[1m])) or ((rate(om1_request_total_seconds_sum{kind=\"tts\"}[1m]) / rate(om1_request_total_seconds_count{kind=\"tts\"}[1m])) * 0))",
          "legendFormat": "TTS (total \u2212 proxy*)",
          "refId": "B"
