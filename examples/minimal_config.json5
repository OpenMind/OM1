{
  // Minimal OM1 Configuration
  // Simplest working configuration for testing and basic functionality

  "hertz": 0.1,
  "name": "minimal_robot",
  "api_key": "openmind_free",

  // No inputs - responds only to voice/audio
  "agent_inputs": [],

  // Web-based debugging interface
  "simulators": [
    {
      "type": "WebSim",
      "config": {
        "host": "0.0.0.0",
        "port": 8001,
        "tick_rate": 100
      }
    }
  ],

  // No background tasks
  "backgrounds": [],

  // LLM configuration
  "cortex_llm": {
    "type": "OpenAILLM",
    "config": {
      "agent_name": "MinimalBot",
      "history_length": 1
    }
  },

  // Simple speak action
  "agent_actions": [
    {
      "name": "speak",
      "llm_label": "speak",
      "implementation": "passthrough",
      "connector": "elevenlabs_tts"
    }
  ]
}
